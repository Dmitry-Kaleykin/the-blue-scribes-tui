{
  "name": "the-blue-scribes-tui",
  "version": "0.1.0",
  "description": "Interactive terminal interface for The Blue Scribes",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "scribes-tui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.0",
    "the-blue-scribes": "file:../the-blue-scribes"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
